{
  "name": "geniex-studio",
  "productName": "GenieX Studio",
  "version": "0.1.0",
  "description": "Local-first desktop studio for Qualcomm GenieX on Snapdragon — chat, vision and agents on the Hexagon NPU.",
  "main": "./out/main/index.js",
  "author": "stama",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "serve": "tsx --tsconfig tsconfig.node.json src/main/server/standalone.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win nsis --arm64",
    "package:dir": "npm run build && electron-builder --win dir --arm64"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.31.0",
    "mermaid": "11.16.1",
    "motion": "13.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zustand": "5.0.15"
  }
}
